# F1 PostgreSQL
F1_DB_USER=f1user
F1_DB_PASSWORD=replace_with_local_password
F1_DB_NAME=f1db

# Kestra PostgreSQL
KESTRA_DB_USER=kestrauser
KESTRA_DB_PASSWORD=replace_with_local_password
KESTRA_DB_NAME=kestradb

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=replace_with_local_password

# Host directory containing raw F1 data
F1_RAW_DATA_PATH=/absolute/path/to/f1-data-engneering/data/raw